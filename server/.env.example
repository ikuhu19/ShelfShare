# Server Port (Render sets this automatically)
PORT=5000

# Environment mode (development / production)
NODE_ENV=development

# Allowed Origins for CORS (comma-separated if multiple, e.g., your Vercel URL)
CORS_ORIGIN=http://localhost:5173,https://your-shelfshare-frontend.vercel.app

# Database Option 1: Unified Cloud Connection String (TiDB, PlanetScale, Railway, Aiven)
# DATABASE_URL=mysql://username:password@hostname:3306/shelfshare?ssl={"rejectUnauthorized":true}

# Database Option 2: Discrete MySQL Parameters
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your_mysql_password
DB_NAME=shelfshare
DB_SSL=false

